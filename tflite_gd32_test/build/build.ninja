build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/wuster/projects/python/TinyML_Labs/tflite_gd32_test/build && /usr/bin/cmake --regenerate-during-build -S/home/wuster/projects/python/TinyML_Labs/tflite_gd32_test -B/home/wuster/projects/python/TinyML_Labs/tflite_gd32_test/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


